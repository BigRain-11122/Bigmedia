# BigStream — product repo local exclusions
# heavy binaries & artifacts (video/image renders) never enter git
output/*
!output/schedule.md
!output/analytics.md
!output/reports/
!output/renders/
!output/finished.md
data/assets/
*.mp4
*.mov
*.avi
*.wav
# secrets (docs/accounts.md discipline)
.env
.env.*
# runtime junk
logs/
__pycache__/
*.pyc
*.log
# session middleware never enters git (tech#157 born-fix; tech#81 self-include retired)
.c3-tmp/
.codely-cli/scheduled_tasks.json
.codely-cli/auto-saves/
data/storylines/audio/*.mp3
.codely-cli/
